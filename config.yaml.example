# AI Utils Configuration Example
# Copy this file to:
#   - ~/.aiu/config.yaml (global)
#   - <workspace>/.aiu/config.yaml (workspace; overrides global)

# プロンプトディレクトリ（複数指定可）
# デフォルトは以下（workspace が global より優先）:
#   - <workspace>/.aiu/prompts
#   - ~/.aiu/prompts
#
#prompt_dirs:
#  - ~/.aiu/prompts
#  - ~/.local/share/ai-utils/prompts

# デフォルトの出力言語 (例: en, ja, French)
output_lang: en

# プロバイダー優先度（上から順に試行）
provider_priority:
  - claude
  - gemini
  - codex
  - copilot

# プロバイダー別設定
providers:
  claude:
    command: claude
    args:
      - "-p"
      - "--output-format"
      - "text"
      - "--settings"
      - "{\"attribution\":{\"commit\":\"\",\"pr\":\"\"},\"includeCoAuthoredBy\":false,\"gitAttribution\":false}"
    timeout: 120s
  gemini:
    command: gemini
    args: []
    timeout: 120s
  codex:
    command: codex
    args: []
    model: ""
    timeout: 120s
  copilot:
    command: copilot
    args:
      - "-s"
    model: ""
    timeout: 120s

# デフォルト設定
defaults:
  timeout: 60s
  verbose: false
